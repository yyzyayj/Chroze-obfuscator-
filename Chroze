"use strict";
const crypto = require("node:crypto");
const { transform } = require("../lib/luau");

module.exports = (req, res) => {
  if (req.method !== "POST") {
    res.setHeader("Allow", "POST");
    return res.status(405).json({ error: "Use POST for this endpoint." });
  }
  try {
    const body = req.body || {};
    if (typeof body.code !== "string") return res.status(400).json({ error: "Source code must be text." });
    const result = transform(body.code, body.options || {});
    const checksum = crypto.createHash("sha256").update(result.output, "utf8").digest("hex");
    return res.status(200).json({
      output: result.output, checksum, tokenCount: result.tokenCount,
      outputBytes: Buffer.byteLength(result.output, "utf8"),
      note: "Lexical source transformation only; review and test the output."
    });
  } catch (error) {
    return res.status(400).json({ error: error.message || "Unable to transform this source." });
  }
};

