'use strict';

const byId = (id) => document.getElementById(id);
const source = byId('source');
const output = byId('output');
const status = byId('status');
const obfuscateButton = byId('obfuscateButton');
const validateButton = byId('validateButton');

const sample = `local function greet(name: string): string
    local message = "Hello, " .. name .. "!"
    print(message)
    return message
end

greet("Luau")`;

function setStatus(message, kind = '') {
  status.textContent = message;
  status.className = 'status' + (kind ? ` ${kind}` : '');
}

function updateCounts() {
  byId('inputCount').textContent = `${source.value.length.toLocaleString()} characters`;
  byId('outputCount').textContent = output.value ? `${output.value.length.toLocaleString()} characters` : 'Waiting for code';
}

function currentOptions() {
  return {
    encodeStrings: byId('encodeStrings').checked,
    stripComments: byId('stripComments').checked,
    compact: byId('compact').checked,
    addBanner: byId('addBanner').checked
  };
}

async function sendJson(url, payload) {
  const response = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });
  let data;
  try { data = await response.json(); } catch { data = {}; }
  if (!response.ok) throw new Error(data.error || `Request failed (${response.status}).`);
  return data;
}

obfuscateButton.addEventListener('click', async () => {
  if (!source.value.trim()) {
    setStatus('Paste your Luau source code first.', 'error');
    source.focus();
    return;
  }
  obfuscateButton.disabled = true;
  validateButton.disabled = true;
  obfuscateButton.querySelector('span').textContent = 'Working…';
  setStatus('Transforming source…');
  try {
    const data = await sendJson('/api/obfuscate', { code: source.value, options: currentOptions() });
    output.value = data.output;
    byId('outputHash').textContent = `SHA-256: ${data.checksum}`;
    updateCounts();
    setStatus(`Done · ${data.tokenCount.toLocaleString()} tokens transformed. ${data.note}`, 'success');
  } catch (error) {
    setStatus(error.message || 'Transformation failed.', 'error');
  } finally {
    obfuscateButton.disabled = false;
    validateButton.disabled = false;
    obfuscateButton.querySelector('span').textContent = 'Transform source';
  }
});

validateButton.addEventListener('click', async () => {
  if (!source.value.trim()) {
    setStatus('Paste your Luau source code first.', 'error');
    source.focus();
    return;
  }
  validateButton.disabled = true;
  obfuscateButton.disabled = true;
  setStatus('Checking strings, comments, and paired delimiters…');
  try {
    const data = await sendJson('/api/validate', { code: source.value });
    setStatus(data.valid ? data.message : `Check failed: ${data.message}`, data.valid ? 'success' : 'error');
  } catch (error) {
    setStatus(error.message || 'Check failed.', 'error');
  } finally {
    validateButton.disabled = false;
    obfuscateButton.disabled = false;
  }
});

byId('loadSample').addEventListener('click', () => {
  source.value = sample;
  updateCounts();
  setStatus('Sample loaded. Click Transform source to test the app.');
});

byId('clearInput').addEventListener('click', () => {
  source.value = '';
  output.value = '';
  byId('outputHash').textContent = 'SHA-256: —';
  updateCounts();
  setStatus('Input and output cleared.');
  source.focus();
});

byId('copyOutput').addEventListener('click', async () => {
  if (!output.value) return setStatus('There is no output to copy yet.', 'error');
  try {
    await navigator.clipboard.writeText(output.value);
    setStatus('Output copied to clipboard.', 'success');
  } catch {
    output.focus();
    output.select();
    setStatus('Clipboard access was blocked. Output is selected; copy it manually.', 'error');
  }
});

byId('downloadOutput').addEventListener('click', () => {
  if (!output.value) return setStatus('There is no output to download yet.', 'error');
  const blob = new Blob([output.value], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = 'chroze-obfuscated.lua';
  document.body.appendChild(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
  setStatus('Downloaded chroze-obfuscated.lua.', 'success');
});

source.addEventListener('input', updateCounts);
updateCounts();

'use strict';

const crypto = require('node:crypto');
const { transform } = require('../lib/luau');

module.exports = (req, res) => {
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'POST');
    return res.status(405).json({ error: 'Use POST for this endpoint.' });
  }
  try {
    const body = req.body || {};
    const result = transform(body.code, body.options || {});
    const checksum = crypto.createHash('sha256').update(result.output, 'utf8').digest('hex');
    return res.status(200).json({
      output: result.output,
      checksum,
      sourceCharacters: body.code.length,
      outputCharacters: result.output.length,
      tokenCount: result.tokenCount,
      settings: result.settings,
      note: 'This is lexical source transformation, not a full Luau AST/VM compiler. Review and test generated code before use.'
    });
  } catch (error) {
    return res.status(400).json({ error: error.message || 'Unable to transform this source.' });
  }
};

'use strict';

const { validate } = require('../lib/luau');

module.exports = (req, res) => {
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'POST');
    return res.status(405).json({ error: 'Use POST for this endpoint.' });
  }
  const body = req.body || {};
  return res.status(200).json(validate(body.code));
};

'use strict';

const MULTI_OPERATORS = [
  '...', '//=', '..=', '==', '~=', '<=', '>=', '+=', '-=', '*=', '/=', '%=', '^=', '//', '..', '::', '->', '??', '?.', '<<', '>>'
].sort((a, b) => b.length - a.length);

function longBracketOpen(source, index) {
  const match = /^\[(=*)\[/.exec(source.slice(index));
  if (!match) return null;
  return { equals: match[1], length: match[0].length };
}

function longBracketClose(source, from, equals) {
  return source.indexOf(']' + equals + ']', from);
}

function readQuoted(source, start) {
  const quote = source[start];
  let i = start + 1;
  while (i < source.length) {
    const char = source[i];
    if (char === quote) return { text: source.slice(start, i + 1), end: i + 1 };
    if (char === '\n' || char === '\r') {
      throw new Error(`Unescaped newline in quoted string at character ${start + 1}.`);
    }
    if (char === '\\') {
      i++;
      if (i >= source.length) break;
      if (source[i] === '\r' && source[i + 1] === '\n') i += 2;
      else i++;
    } else {
      i++;
    }
  }
  throw new Error(`Unterminated quoted string at character ${start + 1}.`);
}

function readLongString(source, start) {
  const open = longBracketOpen(source, start);
  if (!open) return null;
  const closeToken = ']' + open.equals + ']';
  const closeAt = longBracketClose(source, start + open.length, open.equals);
  if (closeAt < 0) throw new Error(`Unterminated long string at character ${start + 1}.`);
  return { text: source.slice(start, closeAt + closeToken.length), end: closeAt + closeToken.length, openLength: open.length, closeLength: closeToken.length };
}

function readComment(source, start) {
  const open = longBracketOpen(source, start + 2);
  if (!open) {
    let end = start + 2;
    while (end < source.length && source[end] !== '\n' && source[end] !== '\r') end++;
    return { text: source.slice(start, end), end, long: false };
  }
  const closeToken = ']' + open.equals + ']';
  const closeAt = longBracketClose(source, start + 2 + open.length, open.equals);
  if (closeAt < 0) throw new Error(`Unterminated long comment at character ${start + 1}.`);
  return { text: source.slice(start, closeAt + closeToken.length), end: closeAt + closeToken.length, long: true };
}


function readInterpolatedExpression(source, start) {
  let i = start;
  let depth = 1;
  while (i < source.length) {
    const ch = source[i];
    if (ch === "\"" || ch === "'") {
      i = readQuoted(source, i).end;
      continue;
    }
    if (ch === '`') {
      i = readInterpolatedString(source, i).end;
      continue;
    }
    if (ch === '-' && source[i + 1] === '-') {
      i = readComment(source, i).end;
      continue;
    }
    if (ch === '[') {
      const longString = readLongString(source, i);
      if (longString) {
        i = longString.end;
        continue;
      }
    }
    if (ch === '{') depth++;
    else if (ch === '}') {
      depth--;
      if (depth === 0) return i + 1;
    }
    i++;
  }
  throw new Error(`Unterminated interpolation expression at character ${start}.`);
}

function readInterpolatedString(source, start) {
  let i = start + 1;
  while (i < source.length) {
    const ch = source[i];
    if (ch === '\\') {
      i++;
      if (i < source.length) {
        if (source[i] === '\r' && source[i + 1] === '\n') i += 2;
        else i++;
      }
      continue;
    }
    if (ch === '`') return { text: source.slice(start, i + 1), end: i + 1 };
    if (ch === '{') {
      i = readInterpolatedExpression(source, i + 1);
      continue;
    }
    i++;
  }
  throw new Error(`Unterminated interpolated string at character ${start + 1}.`);
}

function readNumber(source, start) {
  const rest = source.slice(start);
  const pattern = /^(?:0[xX][0-9a-fA-F_]+(?:\.[0-9a-fA-F_]*)?(?:[pP][+-]?[0-9_]+)?|(?:\d[\d_]*(?:\.[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?[\d_]+)?)/;
  const match = pattern.exec(rest);
  if (!match) return null;
  let text = match[0];
  // Avoid consuming the first dot of a concatenation operator such as 1..value.
  if (text.endsWith('.') && rest[text.length] === '.') text = text.slice(0, -1);
  return text || null;
}

function tokenize(source) {
  const tokens = [];
  let i = 0;
  while (i < source.length) {
    const start = i;
    const ch = source[i];

    if (/\s/.test(ch)) {
      i++;
      while (i < source.length && /\s/.test(source[i])) i++;
      tokens.push({ kind: 'space', text: source.slice(start, i) });
      continue;
    }

    if (ch === '-' && source[i + 1] === '-') {
      const comment = readComment(source, i);
      i = comment.end;
      tokens.push({ kind: 'comment', text: comment.text, long: comment.long });
      continue;
    }

    if (ch === '"' || ch === "'") {
      const quoted = readQuoted(source, i);
      i = quoted.end;
      tokens.push({ kind: 'string', text: quoted.text });
      continue;
    }

    if (ch === '`') {
      const interpolated = readInterpolatedString(source, i);
      i = interpolated.end;
      tokens.push({ kind: 'template', text: interpolated.text });
      continue;
    }

    if (ch === '[') {
      const longString = readLongString(source, i);
      if (longString) {
        i = longString.end;
        tokens.push({ kind: 'longstring', text: longString.text, openLength: longString.openLength, closeLength: longString.closeLength });
        continue;
      }
    }

    if (/[A-Za-z_]/.test(ch)) {
      i++;
      while (i < source.length && /[A-Za-z0-9_]/.test(source[i])) i++;
      tokens.push({ kind: 'word', text: source.slice(start, i) });
      continue;
    }

    if (/\d/.test(ch) || (ch === '.' && /\d/.test(source[i + 1] || ''))) {
      const number = readNumber(source, i);
      if (number) {
        i += number.length;
        tokens.push({ kind: 'number', text: number });
        continue;
      }
    }

    const operator = MULTI_OPERATORS.find((item) => source.startsWith(item, i));
    if (operator) {
      i += operator.length;
      tokens.push({ kind: 'symbol', text: operator });
      continue;
    }

    i++;
    tokens.push({ kind: 'symbol', text: ch });
  }
  return tokens;
}

function appendUtf8Bytes(out, text) {
  for (const byte of Buffer.from(text, 'utf8')) out.push(byte);
}

function decodeQuotedBytes(raw) {
  const out = [];
  const bodyEnd = raw.length - 1;
  let i = 1;
  while (i < bodyEnd) {
    const ch = raw[i];
    if (ch !== '\\') {
      const codePoint = raw.codePointAt(i);
      const value = String.fromCodePoint(codePoint);
      appendUtf8Bytes(out, value);
      i += value.length;
      continue;
    }

    i++;
    if (i >= bodyEnd) throw new Error('Invalid trailing escape in string literal.');
    const escaped = raw[i];
    const simple = {
      a: 7, b: 8, f: 12, n: 10, r: 13, t: 9, v: 11,
      '\\': 92, '"': 34, "'": 39
    };
    if (Object.prototype.hasOwnProperty.call(simple, escaped)) {
      out.push(simple[escaped]);
      i++;
      continue;
    }
    if (escaped === '\n') {
      out.push(10);
      i++;
      continue;
    }
    if (escaped === '\r') {
      out.push(10);
      i += raw[i + 1] === '\n' ? 2 : 1;
      continue;
    }
    if (escaped === 'z') {
      i++;
      while (i < bodyEnd && /\s/.test(raw[i])) i++;
      continue;
    }
    if (escaped === 'x') {
      const hex = raw.slice(i + 1, i + 3);
      if (!/^[0-9a-fA-F]{2}$/.test(hex)) throw new Error('Invalid \\x escape in string literal.');
      out.push(parseInt(hex, 16));
      i += 3;
      continue;
    }
    if (escaped === 'u' && raw[i + 1] === '{') {
      const end = raw.indexOf('}', i + 2);
      if (end < 0) throw new Error('Invalid Unicode escape in string literal.');
      const hex = raw.slice(i + 2, end);
      if (!/^[0-9a-fA-F]+$/.test(hex)) throw new Error('Invalid Unicode escape in string literal.');
      const cp = parseInt(hex, 16);
      if (cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) throw new Error('Unicode escape is out of range.');
      appendUtf8Bytes(out, String.fromCodePoint(cp));
      i = end + 1;
      continue;
    }
    if (/\d/.test(escaped)) {
      let digits = escaped;
      let j = i + 1;
      while (j < bodyEnd && digits.length < 3 && /\d/.test(raw[j])) digits += raw[j++];
      const value = parseInt(digits, 10);
      if (value > 255) throw new Error('Decimal string escapes must be between 0 and 255.');
      out.push(value);
      i = j;
      continue;
    }
    // Luau accepts escaped punctuation as that punctuation in a quoted string.
    appendUtf8Bytes(out, escaped);
    i++;
  }
  return out;
}

function decodeLongStringBytes(token) {
  const openLength = token.openLength;
  const closeLength = token.closeLength;
  let body = token.text.slice(openLength, token.text.length - closeLength);
  body = body.replace(/\r\n?/g, '\n');
  if (body.startsWith('\n')) body = body.slice(1);
  return Array.from(Buffer.from(body, 'utf8'));
}

function encodeBytesAsLuaString(bytes) {
  return '"' + bytes.map((byte) => '\\' + String(byte).padStart(3, '0')).join('') + '"';
}

function needsSpace(previous, current) {
  if (!previous || !current) return false;
  const atomKinds = new Set(['word', 'number', 'string', 'longstring', 'template']);
  if (atomKinds.has(previous.kind) && atomKinds.has(current.kind)) return true;
  if (previous.kind === 'number' && current.text.startsWith('.')) return true;
  const joined = previous.text + current.text;
  try {
    const combinedTokens = tokenize(joined).filter((token) => token.kind !== 'space');
    return combinedTokens.length !== 2 || combinedTokens[0].text !== previous.text || combinedTokens[1].text !== current.text;
  } catch {
    return true;
  }
}

function transform(source, options = {}) {
  if (typeof source !== 'string') throw new Error('Source must be text.');
  if (source.length === 0) throw new Error('Paste your Luau source code first.');
  if (source.length > 150000) throw new Error('Source is too large. The current limit is 150,000 characters.');

  const settings = {
    stripComments: options.stripComments !== false,
    encodeStrings: options.encodeStrings === true,
    compact: options.compact !== false,
    addBanner: options.addBanner !== false
  };
  const tokens = tokenize(source);
  const transformed = [];

  for (const token of tokens) {
    if (token.kind === 'space') {
      if (!settings.compact) transformed.push(token);
      continue;
    }
    if (token.kind === 'comment') {
      if (!settings.stripComments) transformed.push(token);
      continue;
    }
    if (settings.encodeStrings && token.kind === 'string') {
      transformed.push({ kind: 'string', text: encodeBytesAsLuaString(decodeQuotedBytes(token.text)) });
      continue;
    }
    if (settings.encodeStrings && token.kind === 'longstring') {
      transformed.push({ kind: 'string', text: encodeBytesAsLuaString(decodeLongStringBytes(token)) });
      continue;
    }
    transformed.push(token);
  }

  let output = '';
  if (!settings.compact) {
    output = transformed.map((token) => token.text).join('');
  } else {
    let previous = null;
    for (const token of transformed) {
      if (token.kind === 'comment') {
        if (output && !/\s$/.test(output) && needsSpace(previous, token)) output += ' ';
        output += token.text;
        if (!token.long && !/[\r\n]$/.test(output)) output += '\n';
        else if (token.long && !/[\r\n]$/.test(output)) output += '\n';
        previous = null;
        continue;
      }
      if (previous && needsSpace(previous, token)) output += ' ';
      output += token.text;
      previous = token;
    }
  }

  if (settings.addBanner) output = '-- this file was protected by Chroze\n' + output;
  return { output, settings, tokenCount: tokens.filter((token) => token.kind !== 'space' && token.kind !== 'comment').length };
}

function validate(source) {
  if (typeof source !== 'string' || source.trim().length === 0) return { valid: false, message: 'Paste your Luau source code first.' };
  if (source.length > 150000) return { valid: false, message: 'Source is too large. The current limit is 150,000 characters.' };
  let tokens;
  try {
    tokens = tokenize(source);
  } catch (error) {
    return { valid: false, message: error.message };
  }
  const stack = [];
  const opening = { '(': ')', '[': ']', '{': '}' };
  const closing = new Set([')', ']', '}']);
  for (const token of tokens) {
    if (token.kind !== 'symbol') continue;
    if (opening[token.text]) stack.push({ expected: opening[token.text], text: token.text });
    else if (closing.has(token.text)) {
      const last = stack.pop();
      if (!last || last.expected !== token.text) return { valid: false, message: `Mismatched closing delimiter "${token.text}".` };
    }
  }
  if (stack.length) return { valid: false, message: `Missing closing delimiter "${stack[stack.length - 1].expected}".` };
  return { valid: true, message: 'Lexical and delimiter checks passed. This is not a full Luau compiler or grammar validator.', tokens: tokens.filter((token) => token.kind !== 'space' && token.kind !== 'comment').length };
}

module.exports = { tokenize, transform, validate };
