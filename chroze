        <label class="option"><input id="encodeStrings" type="checkbox" checked><span><b>Encode strings</b><small>Convert string literal bytes to decimal escapes.</small></span></label>
        <label class="option"><input id="stripComments" type="checkbox" checked><span><b>Remove comments</b><small>Strip Lua line and long comments.</small></span></label>
        <label class="option"><input id="compact" type="checkbox" checked><span><b>Compact output</b><small>Remove redundant whitespace safely between tokens.</small></span></label>
