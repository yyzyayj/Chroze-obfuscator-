  <main class="shell">
    <header class="topbar">
      <div class="brand-mark" aria-hidden="true">C</div>
      <div class="brand-copy">
        <p class="eyebrow">LUAU SOURCE TOOL</p>
        <h1>Chroze <span>Obfuscator</span></h1>
      </div>
      <span class="version">BROWSER APP</span>
    </header>

    <section class="intro">
      <p class="kicker">SOURCE TRANSFORMATION</p>
      <h2>Make your Luau source harder to read.</h2>
      <p class="intro-copy">Compact source, remove comments, and encode string literals. Paste code, transform it, then review the result before using it.</p>
    </section>

    <section class="workspace" aria-label="Obfuscator workspace">
      <div class="pane">
        <div class="pane-header"><label for="source">INPUT SOURCE</label><span id="inputCount">0 characters</span></div>
        <textarea id="source" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="Paste your Luau code here..."></textarea>
        <div class="pane-footer">
          <button id="loadSample" class="text-button" type="button">Load sample</button>
          <button id="clearInput" class="text-button" type="button">Clear input</button>
        </div>
      </div>
      <div class="pane">
        <div class="pane-header"><label for="output">OUTPUT</label><span id="outputCount">Waiting for code</span></div>
        <textarea id="output" spellcheck="false" autocomplete="off" autocapitalize="off" readonly placeholder="Your transformed Luau code will appear here..."></textarea>
        <div class="pane-footer output-footer">
          <span id="outputHash" class="hash">SHA-256: —</span>
          <div class="output-actions">
            <button id="copyOutput" class="text-button" type="button">Copy</button>
            <button id="downloadOutput" class="text-button" type="button">Download .lua</button>
          </div>
        </div>
      </div>
    </section>

